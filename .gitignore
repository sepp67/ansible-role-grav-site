# Ansible
*.retry
.cache/
__pycache__/
*.pyc

# Cache local des rôles / collections Ansible — jamais versionné
# (ansible-galaxy le recrée à la demande ; aucun code de ce dépôt ne s'en
# sert : les playbooks résolvent le rôle par "{{ playbook_dir }}/..").
.ansible/
/roles/

# Vault déchiffré réel — jamais commité (seul vault.yml.example l'est).
# Couvre inventories/production/group_vars/grav_servers/vault.yml et tout
# autre environnement créé sur ce modèle.
**/vault.yml

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Artefacts temporaires
*.log

# Dépôts de référence locaux (hors périmètre Git de ce dépôt)
/Ressources/
