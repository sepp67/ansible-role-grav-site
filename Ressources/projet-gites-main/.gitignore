# Secrets runtime auto-générés par Grav — ne doivent jamais être versionnés
grav/user/config/security-private.php
grav/user/config/plugins/api-private.php
grav/user/config/plugins/email-private.php

# Comptes utilisateurs (données sensibles)
grav/user/accounts/

# Données d'exécution
grav/user/cache/
grav/user/logs/
grav/user/backup/
grav/user/images/
grav/user/data/
grav/user/.initialized

# Plugins et thème officiels Grav (vendor, reproductibles via le Dockerfile)
grav/user/plugins/admin2/
grav/user/plugins/api/
grav/user/plugins/email/
grav/user/plugins/error/
grav/user/plugins/flex-objects/
grav/user/plugins/form/
grav/user/plugins/github-markdown-alerts/
grav/user/plugins/login/
grav/user/plugins/problems/
grav/user/plugins/shortcode-core/
grav/user/themes/quark2/
