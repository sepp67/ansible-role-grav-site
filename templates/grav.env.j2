# Fichier généré par le rôle Ansible grav-site — ne pas modifier à la main.
# Contient uniquement les variables d'environnement du contrat grav-runtime
# (voir README.md "Variables d'environnement transmises au conteneur").
#
# Nommé "grav.env" (jamais littéralement ".env") : un fichier nommé ".env" à
# la racine du projet compose est *aussi* lu automatiquement par Docker
# Compose comme contexte d'interpolation ${...} de docker-compose.yml
# lui-même — un mécanisme distinct de env_file, source d'ambiguïté inutile.
#
# Monté avec `format: raw` (voir templates/docker-compose.yml.j2) : chaque
# ligne est prise littéralement après le premier "=", sans dépouillement de
# guillemets ni interpolation ${VAR}/$VAR. Vérifié empiriquement (Docker
# Compose v5.3.1, plugin officiel) : $, #, espaces, guillemets doubles et
# simples, antislash sont tous restitués strictement à l'identique — voir
# tests/test_env_encoding.yml. Sans `format: raw`, Compose interprète "$"
# comme un début de référence de variable même à l'intérieur d'un env_file
# classique (constaté en test : "$ecr" est remplacé par une chaîne vide).
#
# Contrainte : aucune valeur ne doit contenir de retour à la ligne (une
# ligne = une variable, y compris en format raw) — imposé par
# tasks/assert.yml, qui échoue avant que ce fichier ne soit généré.
{% if grav_admin_user %}
GRAV_ADMIN_USER={{ grav_admin_user }}
GRAV_ADMIN_PASSWORD={{ grav_admin_password }}
GRAV_ADMIN_EMAIL={{ grav_admin_email }}
{% endif %}
{% if grav_admin_fullname %}
GRAV_ADMIN_FULLNAME={{ grav_admin_fullname }}
{% endif %}
{% if grav_admin_title %}
GRAV_ADMIN_TITLE={{ grav_admin_title }}
{% endif %}
{% if grav_admin_language %}
GRAV_ADMIN_LANGUAGE={{ grav_admin_language }}
{% endif %}
{% if grav_admin_type %}
GRAV_ADMIN_TYPE={{ grav_admin_type }}
{% endif %}
{% if grav_timezone %}
GRAV_TIMEZONE={{ grav_timezone }}
{% endif %}
{% for key, value in grav_extra_environment.items() %}
{{ key }}={{ value }}
{% endfor %}
