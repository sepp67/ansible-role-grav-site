---
# Modèle de fichier Vault — copier PUIS chiffrer immédiatement :
#
#   cp vault.yml.example vault.yml
#   ansible-vault encrypt vault.yml
#
# Convention de ce dépôt : toute variable sensible est nommée ici avec le
# préfixe vault_ ; main.yml (non chiffré) l'affecte explicitement à la
# variable attendue par le rôle, ex. :
#   grav_admin_password: "{{ vault_grav_admin_password }}"
# jamais l'inverse — aucune valeur sensible ne doit donc jamais apparaître
# dans un fichier non chiffré, et aucune collision de nom n'est possible
# entre les deux jeux de variables.
#
# vault.yml (une fois créé) est ignoré par git — voir .gitignore. Seul ce
# fichier .example, sans aucune valeur réelle, est versionné.

vault_grav_admin_user: ""
vault_grav_admin_password: ""
vault_grav_admin_email: ""
vault_grav_admin_fullname: ""
vault_grav_admin_title: ""
vault_grav_admin_language: ""

# Secret applicatif optionnel (ex. email-private.php de projet-gites) — voir
# grav_secrets dans main.yml. Décommenter et adapter si l'image déployée en
# a besoin ; ne jamais laisser de contenu réel dans ce fichier .example :
# vault_grav_email_private_php: |
#   <?php
#   // contenu réel du secret, uniquement dans vault.yml chiffré
